{
  "expo": {
    "name": "PhysTech",
    "slug": "fiztex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fiztex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#2A8847",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.fiztex.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Вход в Fiztex с помощью Face ID",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kz.fiztex.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2A8847"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна для фото-ответов на вступительном тесте.",
          "photosPermission": "Галерея нужна для фото-ответов на вступительном тесте."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы отсканировать QR-код учителя и отметиться на уроке.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2A8847",
          "defaultChannel": "general"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Вход в Fiztex с помощью Face ID"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c92d2e10-65b4-46e3-a128-35304ba9da57"
      }
    },
    "owner": "zhubanyshzhs-team"
  }
}
