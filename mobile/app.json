{
  "expo": {
    "name": "fiztex",
    "slug": "fiztex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fiztex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#2A8847",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.fiztex.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Вход в Fiztex с помощью Face ID"
      }
    },
    "android": {
      "package": "kz.fiztex.app",
      "adaptiveIcon": {
        "backgroundColor": "#2A8847"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна для фото-ответов на вступительном тесте.",
          "photosPermission": "Галерея нужна для фото-ответов на вступительном тесте."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Вход в Fiztex с помощью Face ID"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
